        <mxCell id="100" value="SRS 7.16 — Add CorporateInvoice and CorporateInvoiceLine to represent monthly corporate billing; exact invoice workflow needs BA approval." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="2096" width="1175.3333333333333" height="97" as="geometry" />
