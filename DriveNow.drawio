          <mxGeometry x="1294.3333333333333" y="1524" width="1211.3333333333333" height="145" as="geometry" />
        </mxCell>
        <mxCell id="87" value="09" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="1534" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="88" value="SRS 7.12 — Use RentalAdditionalDriver with name/license fields and DailyFee; identity fields are proposed because only the fee is explicit." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
