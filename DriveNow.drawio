          <mxGeometry x="1294.3333333333333" y="1810" width="1211.3333333333333" height="105" as="geometry" />
        </mxCell>
        <mxCell id="93" value="11" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="1820" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="94" value="SRS 7.14 — Treat ViolationNo as globally unique because it is issued by the traffic department." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
