        <mxCell id="96" value="12" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="1943" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="97" value="SRS 7.15 — Add SupplierID as a surrogate key; supplier name is not assumed unique." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
