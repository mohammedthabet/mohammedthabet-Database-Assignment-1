        <mxCell id="105" value="15" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="2392" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="106" value="SRS 7.7 — NationalID XOR PassportNumber is required for an Individual Customer; nationality determines which field is populated. Promo discount percentage is assumed to be 0–100 because the SRS gives no explicit range." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="2422" width="1175.3333333333333" height="142" as="geometry" />
        </mxCell>
        <mxCell id="107" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1294.3333333333333" y="2590" width="1211.3333333333333" height="145" as="geometry" />
        </mxCell>
        <mxCell id="108" value="16" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="2600" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="109" value="SRS 7.5 / 7.7 / 7.8 — SIMCardNumber and TaxRegistrationNo are treated as unique identifiers; confirm uniqueness policy with BA." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="2630" width="1175.3333333333333" height="97" as="geometry" />
        </mxCell>
        <mxCell id="110" value="CONTRADICTIONS / AMBIGUITIES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c2410c;strokeColor=#c2410c;strokeWidth=3;fontColor=#ffffff;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2533.6666666666665" y="250" width="1211.3333333333333" height="105" as="geometry" />
        </mxCell>
        <mxCell id="111" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
