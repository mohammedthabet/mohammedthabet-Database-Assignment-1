        <mxCell id="112" value="01" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="390" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="113" value="No direct logical contradiction was found in SRS v1.3. The following are ambiguities that need confirmation rather than proven contradictions." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="420" width="1175.3333333333333" height="97" as="geometry" />
        </mxCell>
        <mxCell id="114" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2533.6666666666665" y="543" width="1211.3333333333333" height="190" as="geometry" />
        </mxCell>
        <mxCell id="115" value="02" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="553" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="116" value="SRS 7.12 says both handover and receiving agents must be recorded on every rental, while the receiving agent is unknown until return. Model ReceivingAgent as NULL while the rental is open and require it when closing/returning the rental." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="583" width="1175.3333333333333" height="142" as="geometry" />
        </mxCell>
        <mxCell id="117" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2533.6666666666665" y="751" width="1211.3333333333333" height="190" as="geometry" />
        </mxCell>
        <mxCell id="118" value="03" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="761" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="119" value="SRS 7.7 says authorized drivers are known only through their company; Stakeholder Interview 8 says some corporate drivers are also Individual Customers. Keep company-scoped driver records and add an optional identity link only after BA approval." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="791" width="1175.3333333333333" height="142" as="geometry" />
        </mxCell>
        <mxCell id="120" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2533.6666666666665" y="959" width="1211.3333333333333" height="190" as="geometry" />
        </mxCell>
        <mxCell id="121" value="04" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="969" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="122" value="SRS 7.16 says a rental may have several payments; the Finance note says corporate clients usually pay one monthly invoice. These can coexist, but the payment-to-invoice allocation workflow is not specified." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="999" width="1175.3333333333333" height="142" as="geometry" />
        </mxCell>
        <mxCell id="123" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2533.6666666666665" y="1167" width="1211.3333333333333" height="190" as="geometry" />
        </mxCell>
        <mxCell id="124" value="05" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="1177" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="125" value="SRS 7.3 says vehicles have a current status, while management also requires a full status audit trail. Store CurrentStatus plus append-only VEHICLE_STATUS_HISTORY; define how the initial history row is created." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="1207" width="1175.3333333333333" height="142" as="geometry" />
        </mxCell>
        <mxCell id="126" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2533.6666666666665" y="1375" width="1211.3333333333333" height="145" as="geometry" />
        </mxCell>
        <mxCell id="127" value="06" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="1385" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="128" value="SRS 7.5 says one device is installed in one vehicle while devices may remain in a warehouse. This is not a conflict: the installation relationship is optional on both sides." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2551.6666666666665" y="1415" width="1175.3333333333333" height="97" as="geometry" />
        </mxCell>
        <mxCell id="129" value="Source basis: DriveNow SRS v1.3, Sections 7–11 and Stakeholder Interview Notes in Section 8." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="3410" width="3640" height="26" as="geometry" />
        </mxCell>
        <mxCell id="130" value="17" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="2750" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="131" value="SRS 7.16 — InvoiceStatus lifecycle values (Draft, Issued, PartiallyPaid, Paid, Overdue, Void) and the initial Draft default are proposed because the SRS does not define them." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="2780" width="1175.3333333333333" height="97" as="geometry" />
        </mxCell>
        <mxCell id="132" value="18" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="2878" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="133" value="SRS 7.16 — UQ(RentalNo) on CORPORATE_INVOICE_LINE assumes each rental can appear on at most one corporate invoice; split billing and invoice adjustments require BA confirmation." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="2908" width="1175.3333333333333" height="97" as="geometry" />
        </mxCell>
        <mxCell id="134" value="19" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="3006" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="135" value="SRS 7.3 / 7.8 — Effective rate and corporate discount periods for the same business key are assumed non-overlapping, using half-open intervals [ValidFrom, ValidTo)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="3036" width="1175.3333333333333" height="97" as="geometry" />
        </mxCell>
        <mxCell id="136" value="20" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="3134" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="137" value="SRS 7.7 — No blacklist-release workflow is modeled because the SRS defines blocking but no reversal process; a blacklist decision remains active until BA defines an explicit release event." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="3164" width="1175.3333333333333" height="97" as="geometry" />
        </mxCell>
        <mxCell id="138" value="21" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="3262" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="139" value="SRS 7.1 / 7.3 / 7.6 / 7.7 / 7.10 / 7.16 — Surrogate identifiers are introduced where the SRS gives no stable key, including assignment, status-history, transfer, blacklist, loyalty-transaction and invoice records." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="3292" width="1175.3333333333333" height="97" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
