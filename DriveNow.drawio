        <mxCell id="76" value="SRS 7.3/7.6/7.12 — CurrentBranch is derived from the latest completed rental ReturnBranch or transfer ToBranch (whichever event is later); otherwise HomeBranch. While rented, it is treated as on-rental, not at a branch." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="952" width="1175.3333333333333" height="97" as="geometry" />
