          <mxGeometry x="1294.3333333333333" y="1687" width="1211.3333333333333" height="105" as="geometry" />
        </mxCell>
        <mxCell id="90" value="10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="1697" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="91" value="SRS 7.12 — Store LateFeeAmount on Rental as the assessed charge; calculation policy remains open." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
