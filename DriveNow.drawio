        <mxCell id="11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2563eb;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" value="SRS 7.1" vertex="1">
          <mxGeometry height="270" width="332" x="69" y="357" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="900" x="415" y="345" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="Employee must be at least 21 years old on HireDate." vertex="1">
          <mxGeometry height="270" width="872" x="429" y="357" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1080" x="1315" y="345" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="A simple CHECK cannot safely compare DateOfBirth with a moving current date and HireDate as an age-at-hire calculation across DBMSs." vertex="1">
          <mxGeometry height="270" width="1052" x="1329" y="357" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1250" x="2395" y="345" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="Enforce in a hiring stored procedure/trigger using HireDate minus DateOfBirth; reject the insert/update if age at hire is below 21." vertex="1">
          <mxGeometry height="270" width="1222" x="2409" y="357" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="360" x="55" y="660" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2563eb;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" value="SRS 7.7" vertex="1">
          <mxGeometry height="270" width="332" x="69" y="672" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="900" x="415" y="660" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="A blacklisted customer cannot create a new reservation." vertex="1">
          <mxGeometry height="270" width="872" x="429" y="672" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1080" x="1315" y="660" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="The rule reads another table and depends on current blacklist state; a row-level CHECK cannot query the blacklist history." vertex="1">
          <mxGeometry height="270" width="1052" x="1329" y="672" as="geometry" />
        </mxCell>
        <mxCell id="24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1250" x="2395" y="660" as="geometry" />
        </mxCell>
        <mxCell id="25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="Use a reservation-creation stored procedure or trigger that checks active blacklist status in the same transaction and prevents booking; verify the deciding employee has an active Branch Manager assignment when creating the blacklist event." vertex="1">
          <mxGeometry height="270" width="1222" x="2409" y="672" as="geometry" />
        </mxCell>
        <mxCell id="26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="360" x="55" y="975" as="geometry" />
        </mxCell>
        <mxCell id="27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2563eb;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" value="SRS 7.9" vertex="1">
          <mxGeometry height="270" width="332" x="69" y="987" as="geometry" />
        </mxCell>
        <mxCell id="28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="900" x="415" y="975" as="geometry" />
        </mxCell>
        <mxCell id="29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="PromoCode usage must never exceed MaxUses and must be valid at reservation time." vertex="1">
          <mxGeometry height="270" width="872" x="429" y="987" as="geometry" />
        </mxCell>
        <mxCell id="30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1080" x="1315" y="975" as="geometry" />
        </mxCell>
        <mxCell id="31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="The rule requires counting other reservation rows and is vulnerable to concurrent bookings; CHECK cannot aggregate rows." vertex="1">
          <mxGeometry height="270" width="1052" x="1329" y="987" as="geometry" />
        </mxCell>
        <mxCell id="32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1250" x="2395" y="975" as="geometry" />
        </mxCell>
        <mxCell id="33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="Use a transaction-safe stored procedure/trigger with appropriate locking or serializable isolation to check validity and reserve a usage slot." vertex="1">
          <mxGeometry height="270" width="1222" x="2409" y="987" as="geometry" />
        </mxCell>
        <mxCell id="34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="360" x="55" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="35" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2563eb;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" value="SRS 7.10" vertex="1">
          <mxGeometry height="270" width="332" x="69" y="1302" as="geometry" />
        </mxCell>
        <mxCell id="36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="900" x="415" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="A loyalty redemption cannot exceed the customer&#39;s available points balance." vertex="1">
          <mxGeometry height="270" width="872" x="429" y="1302" as="geometry" />
        </mxCell>
        <mxCell id="38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1080" x="1315" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="39" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="Balance is derived from multiple ledger rows; CHECK cannot sum other transactions or protect against concurrent redemptions." vertex="1">
          <mxGeometry height="270" width="1052" x="1329" y="1302" as="geometry" />
        </mxCell>
        <mxCell id="40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1250" x="2395" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="41" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="Post Earn/Redeem movements through one stored procedure that locks the customer ledger/balance row, calculates available points and rejects an overdraft." vertex="1">
          <mxGeometry height="270" width="1222" x="2409" y="1302" as="geometry" />
        </mxCell>
        <mxCell id="42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="360" x="55" y="1605" as="geometry" />
        </mxCell>
        <mxCell id="43" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2563eb;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" value="SRS 7.12" vertex="1">
          <mxGeometry height="270" width="332" x="69" y="1617" as="geometry" />
        </mxCell>
        <mxCell id="44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="900" x="415" y="1605" as="geometry" />
        </mxCell>
        <mxCell id="45" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="A rental must have a ReceivingAgent when it is returned/closed, but not before." vertex="1">
          <mxGeometry height="270" width="872" x="429" y="1617" as="geometry" />
        </mxCell>
        <mxCell id="46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1080" x="1315" y="1605" as="geometry" />
        </mxCell>
        <mxCell id="47" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="The required value depends on a state transition and the presence of ActualReturnDateTime, not just a static NOT NULL rule." vertex="1">
          <mxGeometry height="270" width="1052" x="1329" y="1617" as="geometry" />
        </mxCell>
        <mxCell id="48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1250" x="2395" y="1605" as="geometry" />
        </mxCell>
        <mxCell id="49" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="Close/return procedure validates ActualReturnDateTime and ReceivingAgentEmployeeID together, then records both atomically." vertex="1">
          <mxGeometry height="270" width="1222" x="2409" y="1617" as="geometry" />
        </mxCell>
        <mxCell id="50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="360" x="55" y="1920" as="geometry" />
        </mxCell>
        <mxCell id="51" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2563eb;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" value="SRS 7.1" vertex="1">
          <mxGeometry height="270" width="332" x="69" y="1932" as="geometry" />
        </mxCell>
        <mxCell id="52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="900" x="415" y="1920" as="geometry" />
        </mxCell>
        <mxCell id="53" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="A branch must have exactly one active manager, and an employee can manage only one branch at a time." vertex="1">
          <mxGeometry height="270" width="872" x="429" y="1932" as="geometry" />
        </mxCell>
        <mxCell id="54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="295" width="1080" x="1315" y="1920" as="geometry" />
        </mxCell>
        <mxCell id="55" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" value="The rule depends on overlapping effective-date ranges across multiple assignment rows; ordinary UNIQUE does not express time-bounded uniqueness." vertex="1">
