        <mxCell id="82" value="SRS 7.7 — Use an optional LinkedIndividualCustomerNo on AuthorizedDriver to connect known individual customers; confirm identity matching." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
