        </mxCell>
        <mxCell id="103" value="SRS 7.16 — A Payment references exactly one Rental or one CorporateInvoice; corporate payment allocation to multiple invoices is out of current design." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="2259" width="1175.3333333333333" height="97" as="geometry" />
