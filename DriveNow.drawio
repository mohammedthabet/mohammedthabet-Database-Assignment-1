        <mxCell id="85" value="SRS 7.7 — Model blacklist as dated events to preserve decision history; active blacklist state is derived from policy/status." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
