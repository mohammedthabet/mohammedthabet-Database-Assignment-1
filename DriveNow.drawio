        <mxCell id="84" value="08" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="1371" width="1175.3333333333333" height="30" as="geometry" />
