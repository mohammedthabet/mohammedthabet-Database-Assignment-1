        <mxCell id="9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17324d;strokeColor=#17324d;strokeWidth=2;fontColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="ENFORCEMENT" vertex="1">
