        <mxCell id="81" value="07" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
