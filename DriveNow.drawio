        <mxCell id="73" value="SRS 7.3 — VEHICLE_RATE stores historical vehicle-specific overrides for luxury cars that do not use category rates." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
