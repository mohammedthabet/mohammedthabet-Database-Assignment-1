        <mxCell id="77" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1294.3333333333333" y="1075" width="1211.3333333333333" height="105" as="geometry" />
        </mxCell>
        <mxCell id="78" value="06" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#64748b;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1312.3333333333333" y="1085" width="1175.3333333333333" height="30" as="geometry" />
        </mxCell>
        <mxCell id="79" value="SRS 7.7 — Split Customer.Address into Street, City and Governorate; the SRS does not specify its components." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1e293b;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
