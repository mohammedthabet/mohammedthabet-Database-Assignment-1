        <mxCell id="10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#1e293b;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;" value="" vertex="1">
